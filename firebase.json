{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "archive/**",
      "tools/**",
      "i18n/**",
      "migration/**",
      "vercel.json"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "regex": "^/fr$",
        "destination": "/fr/",
        "type": 301
      },
      {
        "source": "/book-demo/team",
        "destination": "/enterprise#demo",
        "type": 301
      },
      {
        "source": "/features",
        "destination": "/advisor#features",
        "type": 301
      },
      {
        "source": "/book-demo",
        "destination": "/advisor#book-demo",
        "type": 301
      },
      {
        "source": "/why-bluemind",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/contact-us",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/enterprise-contact",
        "destination": "/enterprise#demo",
        "type": 301
      },
      {
        "source": "/onboarding",
        "destination": "/contact",
        "type": 301
      },
      {
        "source": "/about-us",
        "destination": "/about",
        "type": 301
      },
      {
        "source": "/product/bluemind-harmony",
        "destination": "/enterprise",
        "type": 301
      },
      {
        "source": "/agency-signup",
        "destination": "/enterprise#demo",
        "type": 301
      },
      {
        "source": "/faqs",
        "destination": "/#faq",
        "type": 301
      },
      {
        "source": "/product",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/pricing",
        "destination": "/advisor#pricing",
        "type": 301
      },
      {
        "source": "/testimonials",
        "destination": "/advisor",
        "type": 301
      },
      {
        "source": "/pricing-plans",
        "destination": "/advisor#pricing",
        "type": 301
      },
      {
        "source": "/product/bluemind-advisor",
        "destination": "/advisor",
        "type": 301
      },
      {
        "source": "/advisor-demo",
        "destination": "/advisor",
        "type": 301
      },
      {
        "source": "/thank-you/**",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/blog/tag/**",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/blog/page/**",
        "destination": "/blog",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|mp4|webm|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  }
}
